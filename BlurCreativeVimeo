  function syncActiveTranscriptCue(curSec) {
    if (!activeTranscriptRows.length) return;
    let matchIdx = -1;
    for (let i = 0; i < activeTranscriptRows.length; i++) {
      if (curSec >= activeTranscriptRows[i].sec) matchIdx = i;
      else break;
    }
    if (matchIdx === activeCueIdx) return;
    if (activeCueIdx >= 0 && activeTranscriptRows[activeCueIdx]) activeTranscriptRows[activeCueIdx].el.classList.remove("active-cue");
    activeCueIdx = matchIdx;
    if (activeCueIdx >= 0 && activeTranscriptRows[activeCueIdx]) activeTranscriptRows[activeCueIdx].el.classList.add("active-cue");
  }

  function updateFrameReadout(curSec) {
