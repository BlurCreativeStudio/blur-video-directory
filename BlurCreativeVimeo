async function vimeoFetch(endpointOrUrl, signal, tokenOverride) {
  const tok = tokenOverride || activeToken;
  const url = endpointOrUrl.startsWith("http") ? endpointOrUrl : "https://api.vimeo.com" + endpointOrUrl;
  const resp = await fetch(url, {
    headers: {
      "Authorization": "bearer " + tok,
      "Accept": "application/vnd.vimeo.*+json;version=3.4"
    },
    signal
  });
  if (!resp.ok) throw new Error("Vimeo API " + resp.status);
  return resp.json();
}

function openLocalDB() {
  return new Promise((resolve, reject) => {
    const req = indexedDB.open("UniversalVimeoDirectoryDB", 1);
    req.onupgradeneeded = () => req.result.createObjectStore("state");
    req.onsuccess = () => resolve(req.result);
    req.onerror = () => reject(req.error);
  });
}

async function dbGet(key) {
  try {
    const db = await openLocalDB();
    return await new Promise(resolve => {
      const req = db.transaction("state", "readonly").objectStore("state").get(key);
      req.onsuccess = () => resolve(req.result ?? null);
      req.onerror = () => resolve(null);
    });
  } catch { return null; }
}

async function dbSet(key, val) {
  try {
    const db = await openLocalDB();
    await new Promise(resolve => {
      const tx = db.transaction("state", "readwrite");
      tx.objectStore("state").put(val, key);
      tx.oncomplete = resolve;
      tx.onerror = resolve;
    });
  } catch {}
}

async function dbClearAll() {
  try {
    const db = await openLocalDB();
    await new Promise(resolve => {
      const tx = db.transaction("state", "readwrite");
      tx.objectStore("state").clear();
      tx.oncomplete = resolve;
      tx.onerror = resolve;
    });
  } catch {}
}

function extractFilenameFromApiObj(v) {
  const cvName = (v?.current_version?.filename || "").trim();
  if (cvName) return cvName;
  for (const d of (v?.download || [])) {
    const link = d?.link || "";
    if (!link) continue;
    try {
      const u = new URL(link);
      const fn = u.searchParams.get("filename") || u.searchParams.get("response-content-disposition") || "";
      if (fn) {
        const decoded = decodeURIComponent(fn);
        const m = decoded.match(/filename\*?=(?:UTF-8'')?"?([^";]+)"?/i);
        const cand = (m ? m[1] : decoded).trim();
        if (cand && cand.includes(".")) return cand;
      }
    } catch {}
  }
  return "";
}

function parseVttTimedInBrowser(vttText) {
  const segments = [];
  let lastSec = -999;
  let curSec = 0;
  const timeRe = /^(?:(\d+):)?(\d{2}):(\d{2})\.\d+\s*-->/;

  for (const rawLine of (vttText || "").split(/\r?\n/)) {
    const s = rawLine.trim();
    if (!s || s.startsWith("WEBVTT") || s.startsWith("NOTE") || /^\d+$/.test(s)) continue;
    const m = s.match(timeRe);
    if (m) {
      curSec = parseInt(m[1] || "0", 10) * 3600 + parseInt(m[2] || "0", 10) * 60 + parseInt(m[3] || "0", 10);
      continue;
    }
    if (s.includes("-->")) continue;
    const cleanLine = s.replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim();
    if (!cleanLine || (segments.length && segments[segments.length - 1].endsWith(cleanLine))) continue;
    if (curSec - lastSec >= 3 || !segments.length) {
      segments.push(`~${curSec} ${cleanLine}`);
      lastSec = curSec;
    } else {
      segments.push(cleanLine);
    }
  }
  return segments.join(" ").trim();
}

function convertVttToSrt(vttText) {
  if (!vttText) return "";
  const lines = vttText.replace(/\r/g, "").split("\n");
  const cues = [];
  const normTime = t => {
    t = t.trim().split(" ")[0].replace(".", ",");
    const p = t.split(":");
    if (p.length === 2) return `00:${p[0].padStart(2, "0")}:${p[1]}`;
    if (p.length === 3) return `${p[0].padStart(2, "0")}:${p[1].padStart(2, "0")}:${p[2]}`;
    return t;
  };

  for (let i = 0; i < lines.length; i++) {
    const line = lines[i].trim();
    if (!line.includes("-->")) continue;
    const rawTimes = line.split(/\s+-->\s+/);
    if (rawTimes.length < 2) continue;
    const start = normTime(rawTimes[0]);
    const end = normTime(rawTimes[1]);
    const textLines = [];
    while (++i < lines.length && lines[i].trim() !== "") {
      const cleaned = lines[i].trim().replace(/<[^>]+>/g, "");
      if (cleaned) textLines.push(cleaned);
    }
    if (textLines.length) cues.push(`${cues.length + 1}\n${start} --> ${end}\n${textLines.join("\n")}`);
  }
  return cues.length ? cues.join("\n\n") + "\n" : "";
}

async function compressJsonToB64(obj) {
  const bytes = new TextEncoder().encode(JSON.stringify(obj));
  const cs = new CompressionStream("deflate");
  const writer = cs.writable.getWriter();
  writer.write(bytes);
  writer.close();
  const u8 = new Uint8Array(await new Response(cs.readable).arrayBuffer());
  const chunks = [];
  for (let i = 0; i < u8.length; i += 0x8000) {
    chunks.push(String.fromCharCode.apply(null, u8.subarray(i, i + 0x8000)));
  }
  return btoa(chunks.join(""));
}

async function unpackCatalog(b64) {
  if (!b64) return null;
  const bin = Uint8Array.from(atob(b64), c => c.charCodeAt(0));
  const ds = new DecompressionStream("deflate");
  const writer = ds.writable.getWriter();
  writer.write(bin);
  writer.close();
  return JSON.parse(await new Response(ds.readable).text());
}

async function resolveFreshStreams(v, abortSignal) {
  const fallback = { bestMp4: "", previewMp4: "", downloadUrl: "", texttracksUri: "", fps: v?.fps || 29.97 };
  if (!v?.id) return fallback;

  const cached = streamSessionCache.get(v.id);
  if (cached && (Date.now() - cached.fetchedAt) < 7200000) return cached;
  if (streamInFlight.has(v.id)) return streamInFlight.get(v.id);

  const promise = (async () => {
    try {
      const data = await vimeoFetch(`/videos/${v.id}?fields=${STREAM_FIELDS}`, abortSignal);
      const files = data.files || [];
      const downloads = data.download || [];
      const ttConn = data.metadata?.connections?.texttracks || {};
      const texttracksUri = (ttConn.total > 0 && ttConn.uri) ? ttConn.uri : "";

      const detectedFn = extractFilenameFromApiObj(data);
      if (detectedFn && !v.filename) v.filename = detectedFn;

      let downloadUrl = downloads.find(d => d.rendition === "source" && d.link)?.link || "";
      if (!downloadUrl && downloads.length) {
        const sortedDl = downloads.filter(d => d.link).sort((a, b) => (Number(b.width) || Number(b.size) || 0) - (Number(a.width) || Number(a.size) || 0));
        if (sortedDl.length) downloadUrl = sortedDl[0].link;
      }

      const mp4s = files.filter(f => f.link && (f.type === "video/mp4" || VALID_MP4_RENDITIONS.has(f.rendition)));
      let bestMp4 = "", previewMp4 = "", fps = v.fps || 29.97;

      if (mp4s.length) {
        const desc = [...mp4s].sort((a, b) => (Number(b.width) || 0) - (Number(a.width) || 0));
        const asc = [...mp4s].sort((a, b) => Math.abs((Number(a.width) || 540) - 540) - Math.abs((Number(b.width) || 540) - 540));
        bestMp4 = desc[0].link || "";
        previewMp4 = asc[0].link || bestMp4;
        if (!downloadUrl) downloadUrl = bestMp4;
        const rawFps = Number(desc[0].fps) || fps;
        if (rawFps > 0 && rawFps <= 240) fps = Math.round(rawFps * 1000) / 1000;
        v.fps = fps;
      }

      const result = { bestMp4, previewMp4, downloadUrl, texttracksUri, fps, fetchedAt: Date.now() };
      if (bestMp4 || downloadUrl || texttracksUri) streamSessionCache.set(v.id, result);
      return result;
    } catch {
      return fallback;
    } finally {
      streamInFlight.delete(v.id);
    }
  })();

  streamInFlight.set(v.id, promise);
  return promise;
}

async function fetchRawVttForVideo(v, texttracksUri) {
  if (v._rawVtt) return v._rawVtt;
  try {
    const ttJson = await vimeoFetch(texttracksUri || `/videos/${v.id}/texttracks`);
    const active = (ttJson.data || []).find(t => t.link);
    if (active?.link) {
      const resp = await fetch(active.link);
      if (resp.ok) return (v._rawVtt = await resp.text());
    }
  } catch {}
  return "";
}

(async function initApp() {
  const [embeddedCatalog, savedDbCatalog, savedLocalCfg] = await Promise.all([
    unpackCatalog(COMPRESSED_CATALOG),
    dbGet("latestCatalog"),
    dbGet("userConfig")
  ]);

  if (BAKED_CONFIG?.token) {
    activeToken = BAKED_CONFIG.token;
    activeConfig = {
      title: BAKED_CONFIG.title || "Vimeo Video Directory",
      exportFileName: cleanHtmlBaseName(BAKED_CONFIG.exportFileName || BAKED_CONFIG.title || "Vimeo Video Directory"),
      primary: BAKED_CONFIG.primary || "#005399",
      accent: BAKED_CONFIG.accent || "#00aeef",
      accountName: BAKED_CONFIG.accountName || ""
    };
  }
  if (savedLocalCfg?.token) {
    activeToken = savedLocalCfg.token;
    activeConfig = {
      title: savedLocalCfg.title || activeConfig.title,
      exportFileName: cleanHtmlBaseName(savedLocalCfg.exportFileName || savedLocalCfg.title || activeConfig.exportFileName),
      primary: savedLocalCfg.primary || activeConfig.primary,
      accent: savedLocalCfg.accent || activeConfig.accent,
      accountName: savedLocalCfg.accountName || activeConfig.accountName
    };
  }
  applyBrandingToDOM(activeConfig);

  let catalog = embeddedCatalog || { v: 2, syncedAt: "", count: 0, totalBytes: 0, videos: [] };
  if (savedDbCatalog?.v === 2 && savedDbCatalog?.videos?.length) {
    if (!embeddedCatalog?.syncedAt || new Date(savedDbCatalog.syncedAt) > new Date(embeddedCatalog.syncedAt)) {
      catalog = savedDbCatalog;
    }
  }

  let videos = catalog.videos || [];
  let videoById = new Map();

  function formatBytes(bytes) {
    bytes = Number(bytes) || 0;
    if (bytes <= 0) return "—";
    const units = ["B", "KB", "MB", "GB", "TB"];
    const i = Math.min(units.length - 1, Math.floor(Math.log(bytes) / Math.log(1024)));
    return (bytes / Math.pow(1024, i)).toFixed(i > 1 ? 2 : 0) + " " + units[i];
  }

  function formatDuration(sec) {
    sec = Math.max(0, Math.floor(Number(sec) || 0));
    const h = Math.floor(sec / 3600), m = Math.floor((sec % 3600) / 60), s = sec % 60;
    return h > 0 ? `${h}:${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}` : `${m}:${String(s).padStart(2, "0")}`;
  }

  function formatPreciseTimecode(sec, fps) {
    sec = Math.max(0, Number(sec) || 0);
    fps = Number(fps) || 29.97;
    const totalFrames = Math.round(sec * fps);
    const m = Math.floor(sec / 60);
    const s = (sec % 60).toFixed(2).padStart(5, "0");
    return `${m}:${s} • Frame ${totalFrames.toLocaleString()} (${fps} fps)`;
  }

  function ensureVideoIndexed(v) {
    if (v._indexed) return v;
    v.id = String(v.id);
    v.fps = Number(v.fps) || 29.97;
    v.duration = Number(v.duration) || 0;
    v.size = Number(v.size) || 0;
    v.views = Number(v.views) || 0;
    v.modified = v.modified || v.created || "";
    v.filename = v.filename || "";
    v.description = v.description || "";
    v.tags = v.tags || [];
    v.transcript = v.transcript || "";

    if (!v.thumb && v.tk) v.thumb = v.tk.startsWith("http") ? v.tk : (THUMB_PREFIX + v.tk);
    if (!v.link) v.link = v.lk ? (v.lk.startsWith("http") ? v.lk : (LINK_PREFIX + v.lk)) : (LINK_PREFIX + v.id);
    if (!v.embed) v.embed = v.ek ? (v.ek.startsWith("http") ? v.ek : (EMBED_PREFIX + v.ek)) : (EMBED_PREFIX + v.id);

    const fname = v.filename;
    const plainTranscript = v.transcript ? v.transcript.replace(/~\d+\s*/g, " ") : "";
    const metaText = `${v.title || ""} ${fname} ${v.description} ${v.tags.join(" ")}`;
    const dur = v.duration;

    const fnSpotMatch = fname ? fname.match(FILENAME_SPOT_TAG_RE) : null;
    const fnSpotSec = fnSpotMatch ? parseInt(fnSpotMatch[1], 10) : null;
    const validFnSpot = fnSpotSec !== null && (dur === 0 || Math.abs(dur - fnSpotSec) <= 4);

    v._titleLower = (v.title || "").toLowerCase();
    v._fileLower = fname.toLowerCase();
    v._metaLower = metaText.toLowerCase();
    v._search = `${metaText} ${plainTranscript}`.toLowerCase();
    v._fnSpotSec = validFnSpot ? fnSpotSec : null;
    v._hasAdMarker = validFnSpot || POSITIVE_AD_RE.test(metaText);
    v._isNonAdMeta = NON_AD_META_RE.test(metaText) && !v._hasAdMarker;
    v._isStandardSpotDur = dur > 0 && STANDARD_SPOT_LENGTHS.some(target => Math.abs(dur - target) <= (target <= 10 ? 1 : 2));

    v._ts = v.created ? Date.parse(v.created) || 0 : 0;
    v._modTs = v.modified ? Date.parse(v.modified) || 0 : v._ts;
    v._createdDate = v._ts ? new Date(v._ts).toLocaleDateString() : "—";
    v._modDate = v._modTs ? new Date(v._modTs).toLocaleDateString() : "—";
    v._durStr = formatDuration(dur);
    v._sizeStr = formatBytes(v.size);
    v._indexed = true;
    delete v._segments;
    return v;
  }

  let allVideosIndexed = false;
  function ensureAllVideosIndexed() {
    if (allVideosIndexed) return;
    for (let i = 0; i < videos.length; i++) ensureVideoIndexed(videos[i]);
    allVideosIndexed = true;
  }

  function registerCatalogArray(arr, immediateSliceCount = 60) {
    videoById = new Map();
    allVideosIndexed = false;
    const limit = Math.min(arr.length, immediateSliceCount);
    for (let i = 0; i < arr.length; i++) {
      videoById.set(String(arr[i].id), arr[i]);
      if (i < limit) ensureVideoIndexed(arr[i]);
    }
    if (limit >= arr.length) { allVideosIndexed = true; return; }
    let cursor = limit;
    const scheduleIdle = window.requestIdleCallback || (cb => setTimeout(cb, 16));
    const stepIndex = () => {
      if (allVideosIndexed || arr !== videos) return;
      const stop = Math.min(arr.length, cursor + 250);
      for (; cursor < stop; cursor++) ensureVideoIndexed(arr[cursor]);
      if (cursor >= arr.length) allVideosIndexed = true;
      else scheduleIdle(stepIndex);
    };
    scheduleIdle(stepIndex);
  }

  const syncInfo = document.getElementById("syncInfo");
  const deltaBadge = document.getElementById("deltaBadge");
  const headerControls = document.getElementById("headerControls");
  const setupWizard = document.getElementById("setupWizard");
  const directoryWorkspace = document.getElementById("directoryWorkspace");
