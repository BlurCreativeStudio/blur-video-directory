    if (!previewCtrl.el.contains(e.relatedTarget)) teardownActivePreview();
  });

  function beginScrubSession(scrubTarget, startClientX, isTouch) {
    const thumbEl = scrubTarget.closest(".row-thumb, .thumb-wrap");
    const v = thumbEl ? videoById.get(thumbEl.dataset.vid) : null;
    if (!thumbEl || !v) return;

    if (previewCtrl.el !== thumbEl) { teardownActivePreview(); previewCtrl.el = thumbEl; previewCtrl.vid = v; }
    if (previewCtrl.timer) { clearTimeout(previewCtrl.timer); previewCtrl.timer = null; }

    previewCtrl.isDragging = true;
    thumbEl._wasDragging = true;
    const zone = thumbEl.querySelector(".scrub-zone");
    if (zone) zone.classList.add("dragging");
    scrubActiveThumbAtClientX(startClientX);

    let latestClientX = startClientX;
    const scheduleScrub = x => {
      latestClientX = x;
      if (!previewCtrl.rafId) {
        previewCtrl.rafId = requestAnimationFrame(() => {
          previewCtrl.rafId = 0;
          if (previewCtrl.isDragging) scrubActiveThumbAtClientX(latestClientX);
        });
      }
    };

    if (isTouch) {
      const onTouchMove = tm => {
        if (tm.touches?.[0]) { tm.preventDefault(); scheduleScrub(tm.touches[0].clientX); }
      };
      const onTouchEnd = () => {
        previewCtrl.isDragging = false;
        if (previewCtrl.rafId) { cancelAnimationFrame(previewCtrl.rafId); previewCtrl.rafId = 0; }
        if (zone) zone.classList.remove("dragging");
        window.removeEventListener("touchmove", onTouchMove);
        window.removeEventListener("touchend", onTouchEnd);
        setTimeout(() => { thumbEl._wasDragging = false; }, 120);
      };
      window.addEventListener("touchmove", onTouchMove, { passive: false });
      window.addEventListener("touchend", onTouchEnd);
    } else {
      const onMove = mv => scheduleScrub(mv.clientX);
      const onUp = uv => {
        previewCtrl.isDragging = false;
        if (previewCtrl.rafId) { cancelAnimationFrame(previewCtrl.rafId); previewCtrl.rafId = 0; }
        if (zone) zone.classList.remove("dragging");
        window.removeEventListener("mousemove", onMove);
        window.removeEventListener("mouseup", onUp);
        setTimeout(() => { thumbEl._wasDragging = false; }, 80);
        const hoveredAfter = document.elementFromPoint(uv.clientX, uv.clientY);
        if (!hoveredAfter || !thumbEl.contains(hoveredAfter)) teardownActivePreview();
      };
      window.addEventListener("mousemove", onMove);
      window.addEventListener("mouseup", onUp);
    }
  }

  mainScrollArea.addEventListener("mousedown", e => {
    const scrubTarget = e.target.closest(".scrub-zone, .scrub-time-pill");
    if (!scrubTarget) return;
    e.stopPropagation();
