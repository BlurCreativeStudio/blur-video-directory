  function buildVideoEntryFromApi(v, prev, transcriptOverride) {
    const id = (v.uri || "").split("/").pop();
    const created = v.created_time || "";
    const mod = v.modified_time || created;

    let fsize = Number(v.upload?.size) || 0;
    if (!fsize && Array.isArray(v.files) && v.files.length) {
      fsize = Number(v.files.find(f => f.rendition === "source" && f.size)?.size) || Math.max(0, ...v.files.map(f => Number(f.size) || 0));
    }

    let fps = 29.97;
    if (Array.isArray(v.files)) {
      const topFile = v.files.filter(f => f.fps).sort((a, b) => (Number(b.width) || 0) - (Number(a.width) || 0))[0];
      const parsed = Number(topFile?.fps) || 29.97;
      if (parsed > 0 && parsed <= 240) fps = Math.round(parsed * 1000) / 1000;
    }

    const extractedFn = extractFilenameFromApiObj(v) || prev?.filename || "";
    const rawThumb = (v.pictures?.base_link || "").trim();
    const rawLink = (v.link || `${LINK_PREFIX}${id}`).trim();
    const rawEmbed = (v.player_embed_url || `${EMBED_PREFIX}${id}`).trim();

    const entry = {
      id,
      title: v.name || "Untitled Video",
      filename: extractedFn,
      description: v.description || "",
      tk: rawThumb.startsWith(THUMB_PREFIX) ? rawThumb.slice(THUMB_PREFIX.length) : rawThumb,
      lk: rawLink !== `${LINK_PREFIX}${id}` ? (rawLink.startsWith(LINK_PREFIX) ? rawLink.slice(LINK_PREFIX.length) : rawLink) : "",
      ek: rawEmbed !== `${EMBED_PREFIX}${id}` ? (rawEmbed.startsWith(EMBED_PREFIX) ? rawEmbed.slice(EMBED_PREFIX.length) : rawEmbed) : "",
      fps,
      duration: Number(v.duration) || 0,
      size: fsize,
      views: Number(v.stats?.plays) || 0,
      created,
      modified: mod,
      tags: (v.tags || []).map(t => t.name).filter(Boolean),
      transcript: transcriptOverride !== undefined ? transcriptOverride : (prev?.modified === mod ? (prev.transcript || "") : "")
    };
    if (v.embed?.html) entry.embedHtml = v.embed.html;
    return entry;
  }

  async function downloadTimedTranscriptForItem(ttUri) {
    try {
      const ttJson = await vimeoFetch(ttUri);
      const active = (ttJson.data || []).find(t => t.link);
      if (active?.link) {
        const vttResp = await fetch(active.link);
        if (vttResp.ok) return parseVttTimedInBrowser(await vttResp.text());
      }
    } catch {}
    return "";
  }

  function stripRuntimePropsForStorage(arr) {
    return arr.map(v => {
      const clean = { id: v.id, title: v.title, created: v.created || "" };
      if (v.modified && v.modified !== v.created) clean.modified = v.modified;
      if (v.duration) clean.duration = v.duration;
      if (v.size) clean.size = v.size;
      if (v.views) clean.views = v.views;
      if (v.fps && v.fps !== 29.97) clean.fps = v.fps;
      if (v.filename) clean.filename = v.filename;
      if (v.description) clean.description = v.description;
      if (v.tags?.length) clean.tags = v.tags;
      if (v.transcript) clean.transcript = v.transcript;
      const tk = v.tk || (v.thumb ? (v.thumb.startsWith(THUMB_PREFIX) ? v.thumb.slice(THUMB_PREFIX.length) : v.thumb) : "");
      if (tk) clean.tk = tk;
      if (v.lk) clean.lk = v.lk;
      if (v.ek) clean.ek = v.ek;
      if (v.embedHtml) clean.embedHtml = v.embedHtml;
      return clean;
    });
  }

  async function commitUpdatedCatalog(updatedVideos) {
