  async function downloadHighResThumbFallback(v, suffix) {
    ensureVideoIndexed(v);
    if (!v?.thumb) { captureStatus.textContent = "No image available"; return; }
    try {
      captureStatus.textContent = "Saving full-res still...";
      const resp = await fetch(`${v.thumb}_1920x1080.jpg`);
      const blob = await resp.blob();
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `${sanitizeFilename(v.title)}${suffix || "_still"}.jpg`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
      captureStatus.textContent = "Saved .JPG!";
      setTimeout(() => { captureStatus.textContent = ""; }, 3000);
    } catch { captureStatus.textContent = "Download failed"; }
  }

  captureStillBtn.addEventListener("click", async () => {
    if (!activeModalVideo) return;
    const vidEl = modalPlayer.querySelector("video");
    if (vidEl && vidEl.readyState >= 2 && vidEl.videoWidth > 0) {
      try {
        const canvas = document.createElement("canvas");
        canvas.width = vidEl.videoWidth;
        canvas.height = vidEl.videoHeight;
        canvas.getContext("2d").drawImage(vidEl, 0, 0, canvas.width, canvas.height);
        const curSec = vidEl.currentTime || 0;
        const frameNum = Math.round(curSec * (activeModalVideo.fps || 29.97));
        const m = String(Math.floor(curSec / 60)).padStart(2, "0");
        const s = String(Math.floor(curSec % 60)).padStart(2, "0");
        canvas.toBlob(blob => {
          if (!blob) return downloadHighResThumbFallback(activeModalVideo, `_${m}m${s}s_f${frameNum}`);
          const url = URL.createObjectURL(blob);
          const a = document.createElement("a");
          a.href = url;
          a.download = `${sanitizeFilename(activeModalVideo.title)}_${m}m${s}s_frame${frameNum}_${canvas.width}x${canvas.height}.jpg`;
          document.body.appendChild(a);
          a.click();
          a.remove();
          URL.revokeObjectURL(url);
          captureStatus.textContent = `Saved Frame ${frameNum}!`;
          setTimeout(() => { captureStatus.textContent = ""; }, 3500);
        }, "image/jpeg", 0.96);
        return;
      } catch {}
    }
    await downloadHighResThumbFallback(activeModalVideo, "_fullres");
  });

  modalTranscript.addEventListener("click", e => {
    const row = e.target.closest(".t-seg");
    if (row?.dataset.sec !== undefined) seekActiveModalTo(Number(row.dataset.sec));
  });

  function renderModalTranscript(v) {
    activeTranscriptRows = [];
    activeCueIdx = -1;
    const segs = getTimedSegments(v);
    if (!segs.length) { modalTranscriptWrap.style.display = "none"; modalTranscript.innerHTML = ""; return; }
    modalTranscriptWrap.style.display = "block";
    const frag = document.createDocumentFragment();
    let firstMatchEl = null;
    const primaryPhrase = currentQueryObj.phrases?.[0] || "";

    for (const seg of segs) {
      const row = document.createElement("div");
      row.className = "t-seg";
      row.dataset.sec = String(seg.sec);
      row.innerHTML = `<span class="t-seg-time">[${formatDuration(seg.sec)}]</span><span class="t-seg-text">${highlightQueryHtml(seg.text, currentQueryObj)}</span>`;
      activeTranscriptRows.push({ sec: seg.sec, el: row });
      if (!firstMatchEl) {
        if (primaryPhrase && seg.lower.includes(primaryPhrase)) firstMatchEl = row;
        else if (!primaryPhrase && currentQueryObj.tokens.length && currentQueryObj.tokens.every(t => seg.lower.includes(t))) firstMatchEl = row;
      }
      frag.appendChild(row);
    }
    modalTranscript.innerHTML = "";
    modalTranscript.appendChild(frag);
    if (firstMatchEl) setTimeout(() => firstMatchEl.scrollIntoView({ behavior: "smooth", block: "center" }), 120);
  }

  async function openVideo(v, startAtSec = 0) {
    ensureVideoIndexed(v);
    teardownActivePreview();
    if (modalStreamAbort) modalStreamAbort.abort();
    modalStreamAbort = new AbortController();

    activeModalVideo = v;
    iframeTrackedTime = startAtSec || 0;
    iframeIsPaused = false;
    captureStatus.textContent = "";
    modalDownloadMp4Btn.style.display = "none";
    modalDownloadSrtBtn.style.display = v.transcript ? "inline-block" : "none";
    modalDownloadTxtBtn.style.display = v.transcript ? "inline-block" : "none";

    modalTitle.textContent = v.title || "Untitled";
    if (v.filename) { modalFileSub.style.display = "block"; modalFileSub.textContent = v.filename; }
    else { modalFileSub.style.display = "none"; modalFileSub.textContent = ""; }

    modalMeta.textContent = `Duration: ${v._durStr}  |  Size: ${v._sizeStr}  |  Views: ${(v.views || 0).toLocaleString()}  |  Uploaded: ${v._createdDate}`;
    modalDesc.textContent = v.description || "";
    renderModalTranscript(v);
    updateFrameReadout(startAtSec || 0);

    modalDownloadTxtBtn.onclick = () => {
      const txtBody = getTimedSegments(v).map(s => `[${formatDuration(s.sec)}] ${s.text}`).join("\n");
      downloadTextBlob(txtBody, `${sanitizeFilename(v.filename || v.title)}_transcript.txt`);
    };

    let resolvedTexttracksUri = "";
    modalDownloadSrtBtn.onclick = async () => {
      const origLabel = modalDownloadSrtBtn.textContent;
      modalDownloadSrtBtn.textContent = "⏳ SRT...";
      const rawVtt = await fetchRawVttForVideo(v, resolvedTexttracksUri);
      const srtContent = (rawVtt ? convertVttToSrt(rawVtt) : "") || buildSrtFallbackFromSegments(getTimedSegments(v));
      downloadTextBlob(srtContent, `${sanitizeFilename(v.filename || v.title)}.srt`);
      modalDownloadSrtBtn.textContent = origLabel;
    };

    modalPlayer.innerHTML = `<div class="stream-loader">Loading high-resolution video stream...</div>`;
    videoModal.classList.add("open");

    const streams = await resolveFreshStreams(v, modalStreamAbort.signal);
    if (activeModalVideo !== v) return;

    if (v.filename && !modalFileSub.textContent) { modalFileSub.style.display = "block"; modalFileSub.textContent = v.filename; }
    resolvedTexttracksUri = streams.texttracksUri || "";
    if (resolvedTexttracksUri && !v.transcript) modalDownloadSrtBtn.style.display = "inline-block";

    const dlTarget = streams.downloadUrl || streams.bestMp4;
    if (dlTarget) {
      modalDownloadMp4Btn.style.display = "inline-block";
      modalDownloadMp4Btn.onclick = () => {
        const a = document.createElement("a");
        a.href = dlTarget;
        a.download = v.filename || `${sanitizeFilename(v.title)}.mp4`;
        a.target = "_blank"; a.rel = "noopener";
        document.body.appendChild(a); a.click(); a.remove();
      };
    }

    if (streams.bestMp4) {
      modalPlayer.innerHTML = `<video src="${streams.bestMp4}" crossorigin="anonymous" controls autoplay playsinline></video>`;
      const vidEl = modalPlayer.querySelector("video");
      if (vidEl) {
        vidEl.addEventListener("loadedmetadata", () => {
          if (startAtSec > 0) vidEl.currentTime = startAtSec;
          updateFrameReadout(vidEl.currentTime || 0);
        }, { once: true });
        vidEl.addEventListener("timeupdate", () => updateFrameReadout(vidEl.currentTime || 0));
        vidEl.addEventListener("seeked", () => updateFrameReadout(vidEl.currentTime || 0));
      }
    } else {
      const sep = v.embed.includes("?") ? "&" : "?";
      const hashTime = startAtSec > 0 ? `#t=${Math.floor(startAtSec)}s` : "";
      modalPlayer.innerHTML = `<iframe src="${v.embed}${sep}api=1&playsinline=1${hashTime}" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>`;
    }
  }

  function closeVideoModal() {
    if (modalStreamAbort) { modalStreamAbort.abort(); modalStreamAbort = null; }
    videoModal.classList.remove("open");
    modalPlayer.innerHTML = "";
    activeModalVideo = null;
    activeTranscriptRows = [];
    activeCueIdx = -1;
    captureStatus.textContent = "";
  }
  closeModal.addEventListener("click", closeVideoModal);
  videoModal.addEventListener("click", e => { if (e.target === videoModal) closeVideoModal(); });

  mainScrollArea.addEventListener("click", e => {
    if (e.target.closest(".scrub-zone, .scrub-time-pill")) return;

    const pageBtn = e.target.closest("[data-page]");
    if (pageBtn && !pageBtn.disabled) {
      const nextP = parseInt(pageBtn.dataset.page, 10);
      if (nextP) goToCatalogPage(nextP);
      return;
    }

    const sbPill = e.target.closest(".soundbite-pill");
    if (sbPill) {
      const vid = videoById.get(sbPill.dataset.vid);
      if (vid) openVideo(vid, Math.max(0, Number(sbPill.dataset.sec || 0) - 1));
      return;
    }

    const thumbEl = e.target.closest(".row-thumb, .thumb-wrap");
    if (thumbEl) {
      if (thumbEl._wasDragging) return;
      const vid = videoById.get(thumbEl.dataset.vid);
      if (vid) openVideo(vid, thumbEl._scrubTime || 0);
      return;
    }

    const actionEl = e.target.closest("[data-action]");
    if (!actionEl) return;
    const vid = videoById.get(actionEl.dataset.vid);
    if (!vid) return;
    ensureVideoIndexed(vid);

    const act = actionEl.dataset.action;
    if (act === "watch") openVideo(vid, 0);
    else if (act === "copy-url") copyToClipboard(vid.link, actionEl, "Copy URL");
    else if (act === "copy-embed") copyToClipboard(getEmbedCode(vid), actionEl, "Copy Embed");
  });

  function buildPageNumberList(cur, total) {
    if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
    const pages = [1];
    if (cur > 3) pages.push("…");
    for (let i = Math.max(2, cur - 1); i <= Math.min(total - 1, cur + 1); i++) pages.push(i);
    if (cur < total - 2) pages.push("…");
    pages.push(total);
    return pages;
  }

  function renderPaginationControls(totalItems, totalPages, startIdx, endIdx) {
    if (totalItems === 0) { paginationBar.style.display = "none"; return; }
    paginationBar.style.display = "flex";
    pageStatus.textContent = `Page ${currentPage.toLocaleString()} of ${totalPages.toLocaleString()} (${(startIdx + 1).toLocaleString()}–${endIdx.toLocaleString()} of ${totalItems.toLocaleString()})`;

    const items = buildPageNumberList(currentPage, totalPages);
    let html = `<button type="button" class="page-btn" data-page="${currentPage - 1}" ${currentPage <= 1 ? "disabled" : ""}>◀ Prev</button>`;
    for (const p of items) {
      html += p === "…" ? `<span class="page-ellipsis">…</span>` : `<button type="button" class="page-btn${p === currentPage ? " active" : ""}" data-page="${p}">${p}</button>`;
    }
    html += `<button type="button" class="page-btn" data-page="${currentPage + 1}" ${currentPage >= totalPages ? "disabled" : ""}>Next ▶</button>`;
    pageControls.innerHTML = html;
  }

  function renderCurrentPage() {
    teardownActivePreview();
    const totalFiltered = currentFiltered.length;
    const totalPages = Math.max(1, Math.ceil(totalFiltered / pageSize));
    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;

    const startIdx = (currentPage - 1) * pageSize;
    const endIdx = Math.min(startIdx + pageSize, totalFiltered);
    const slice = currentFiltered.slice(startIdx, endIdx);

    if (totalFiltered === 0) {
      resultCount.textContent = `Showing 0 of ${videos.length.toLocaleString()} videos`;
      listContainer.style.display = "none";
      gridContainer.style.display = "none";
      emptyState.style.display = "block";
      paginationBar.style.display = "none";
      videoTableBody.innerHTML = "";
      gridContainer.innerHTML = "";
      return;
    }

    emptyState.style.display = "none";
    resultCount.textContent = `Showing ${(startIdx + 1).toLocaleString()}–${endIdx.toLocaleString()} of ${totalFiltered.toLocaleString()} videos`;
    listContainer.style.display = viewMode === "list" ? "block" : "none";
    gridContainer.style.display = viewMode === "grid" ? "grid" : "none";
    videoTableBody.innerHTML = "";
    gridContainer.innerHTML = "";

    const frag = document.createDocumentFragment();
    if (viewMode === "list") {
      for (const v of slice) {
        ensureVideoIndexed(v);
        const tr = document.createElement("tr");
        const thumbUrl = v.thumb ? `${v.thumb}_295x166` : "";
        const soundbites = findSoundbiteMatches(v, currentQueryObj, 3);
        const sbHtml = soundbites.length ? `<div class="soundbite-list">${soundbites.map(sb => `<div class="soundbite-pill" data-vid="${v.id}" data-sec="${sb.sec}"><span class="sb-time">▶ ${formatDuration(sb.sec)}</span><span class="sb-text">${highlightQueryHtml(sb.snippet, currentQueryObj)}</span></div>`).join("")}</div>` : "";
        tr.innerHTML = `
          <td>
            <div class="title-cell">
              <div class="row-thumb" data-vid="${v.id}">
                ${thumbUrl ? `<img src="${thumbUrl}" loading="lazy" decoding="async">` : ""}
                <span class="scrub-time-pill">0:00 / ${v._durStr}</span>
                <div class="scrub-zone"><div class="scrub-track"><div class="scrub-fill"><span class="scrub-handle"></span></div></div></div>
              </div>
              <div class="title-info">
                <span class="row-title" data-action="watch" data-vid="${v.id}">${highlightQueryHtml(v.title || "Untitled", currentQueryObj)}${v.transcript ? `<span class="cc-pill">CC</span>` : ""}</span>
                ${v.description ? `<span class="row-sub">${highlightQueryHtml(v.description, currentQueryObj)}</span>` : ""}
                ${sbHtml}
              </div>
            </div>
          </td>
          <td class="mono-num">${v._durStr}</td>
          <td class="mono-num">${v._sizeStr}</td>
          <td class="mono-num">${(v.views || 0).toLocaleString()}</td>
          <td class="mono-num">${v._createdDate}</td>
          <td class="mono-num">${v._modDate}</td>
          <td>
            <div class="action-group">
              <button class="btn" data-action="watch" data-vid="${v.id}">Watch</button>
              <button class="btn btn-secondary" data-action="copy-url" data-vid="${v.id}">Copy URL</button>
              <button class="btn btn-secondary" data-action="copy-embed" data-vid="${v.id}">Copy Embed</button>
            </div>
          </td>`;
        frag.appendChild(tr);
      }
      videoTableBody.appendChild(frag);
    } else {
      for (const v of slice) {
        ensureVideoIndexed(v);
        const card = document.createElement("div");
        card.className = "card";
        const thumbUrl = v.thumb ? `${v.thumb}_640x360` : "";
        const soundbites = findSoundbiteMatches(v, currentQueryObj, 2);
        const sbHtml = soundbites.length ? `<div class="soundbite-list">${soundbites.map(sb => `<div class="soundbite-pill" data-vid="${v.id}" data-sec="${sb.sec}"><span class="sb-time">▶ ${formatDuration(sb.sec)}</span><span class="sb-text">${highlightQueryHtml(sb.snippet, currentQueryObj)}</span></div>`).join("")}</div>` : "";
        card.innerHTML = `
          <div class="thumb-wrap" data-vid="${v.id}">
            ${thumbUrl ? `<img src="${thumbUrl}" loading="lazy" decoding="async">` : ""}
            ${v.transcript ? `<span class="transcript-badge">CC</span>` : ""}
            <span class="duration-badge">${v._durStr}</span>
            <span class="scrub-time-pill">0:00 / ${v._durStr}</span>
            <div class="scrub-zone"><div class="scrub-track"><div class="scrub-fill"><span class="scrub-handle"></span></div></div></div>
          </div>
          <div class="card-body">
            <div class="card-title" data-action="watch" data-vid="${v.id}">${highlightQueryHtml(v.title || "Untitled", currentQueryObj)}</div>
            <div class="card-meta-row"><span>Size: ${v._sizeStr}</span><span>Views: ${(v.views || 0).toLocaleString()}</span></div>
            ${sbHtml}
            <div class="card-footer">
              <div class="card-dates"><span>Uploaded: ${v._createdDate}</span><span>Modified: ${v._modDate}</span></div>
              <div class="action-group">
                <button class="btn" data-action="watch" data-vid="${v.id}">Watch</button>
                <button class="btn btn-secondary" data-action="copy-url" data-vid="${v.id}">Copy URL</button>
                <button class="btn btn-secondary" data-action="copy-embed" data-vid="${v.id}">Copy Embed</button>
              </div>
            </div>
          </div>`;
        frag.appendChild(card);
      }
      gridContainer.appendChild(frag);
    }
    renderPaginationControls(totalFiltered, totalPages, startIdx, endIdx);
  }

  function render(resetToFirstPage = true) {
    if (resetToFirstPage) currentPage = 1;
    updateSortHeaders();
    currentQueryObj = compileSearchQuery(searchInput.value);
    searchWrap.classList.toggle("has-val", Boolean(currentQueryObj.raw));

    if (!currentQueryObj.raw && sortField === "created" && sortDir === "desc") {
      currentFiltered = videos;
      mainScrollArea.scrollTop = 0;
      renderCurrentPage();
      return;
    }

    ensureAllVideosIndexed();
    currentFiltered = currentQueryObj.raw ? videos.filter(v => matchesAdAndDurationFilter(v, currentQueryObj)) : [...videos];

    const mult = sortDir === "asc" ? 1 : -1;
    currentFiltered.sort((a, b) => {
      if ((currentQueryObj.adIntent || currentQueryObj.targetSec !== null) && sortField === "created" && sortDir === "desc") {
        const diff = scoreAdCandidate(b, currentQueryObj) - scoreAdCandidate(a, currentQueryObj);
        if (diff !== 0) return diff;
      } else if (currentQueryObj.remainingRaw && sortField === "created" && sortDir === "desc") {
        const aExact = (a._titleLower.includes(currentQueryObj.remainingRaw) || a._fileLower.includes(currentQueryObj.remainingRaw)) ? 1 : 0;
        const bExact = (b._titleLower.includes(currentQueryObj.remainingRaw) || b._fileLower.includes(currentQueryObj.remainingRaw)) ? 1 : 0;
        if (aExact !== bExact) return bExact - aExact;
      }
      if (sortField === "created") return (a._ts - b._ts) * mult;
      if (sortField === "modified") return (a._modTs - b._modTs) * mult;
      if (sortField === "size") return (a.size - b.size) * mult;
      if (sortField === "duration") return (a.duration - b.duration) * mult;
      if (sortField === "views") return (a.views - b.views) * mult;
      if (sortField === "title") return TITLE_COLLATOR.compare(a.title || "", b.title || "") * mult;
      return 0;
    });

    mainScrollArea.scrollTop = 0;
    renderCurrentPage();
  }

  listViewBtn.addEventListener("click", () => { viewMode = "list"; listViewBtn.classList.add("active"); gridViewBtn.classList.remove("active"); try { localStorage.setItem("vvd_view", "list"); } catch {} renderCurrentPage(); });
  gridViewBtn.addEventListener("click", () => { viewMode = "grid"; gridViewBtn.classList.add("active"); listViewBtn.classList.remove("active"); try { localStorage.setItem("vvd_view", "grid"); } catch {} renderCurrentPage(); });
  perPageSelect.addEventListener("change", () => { pageSize = parseInt(perPageSelect.value, 10) || 50; try { localStorage.setItem("vvd_pagesize", String(pageSize)); } catch {} currentPage = 1; mainScrollArea.scrollTop = 0; renderCurrentPage(); });
  searchClearBtn.addEventListener("click", () => { searchInput.value = ""; searchInput.focus(); render(true); });

  document.querySelectorAll("th[data-field]").forEach(th => {
    th.addEventListener("click", () => {
      const clickedField = th.getAttribute("data-field");
      if (sortField === clickedField) sortDir = sortDir === "desc" ? "asc" : "desc";
      else { sortField = clickedField; sortDir = th.getAttribute("data-default-dir") || "desc"; }
      render(true);
    });
  });

  sortSelect.addEventListener("change", () => {
    const [f, d] = sortSelect.value.split(":");
    sortField = f; sortDir = d || "desc";
    render(true);
  });

  let debounceTimer;
  searchInput.addEventListener("input", () => { clearTimeout(debounceTimer); debounceTimer = setTimeout(() => render(true), 110); });

  if (!activeToken) {
    showSetupMode();
  } else if (!videos.length) {
    showSetupMode();
    wizTokenInput.value = activeToken;
    wizTitleInput.value = activeConfig.title;
    wizFileNameInput.value = activeConfig.exportFileName || activeConfig.title;
    refreshWizFilenamePreview();
  } else {
    showDirectoryMode();
    setTimeout(runSilentDeltaCheck, 600);
  }
})();
</script>
</body>
</html>
