.row-thumb:hover .scrub-time-pill, .thumb-wrap:hover .scrub-time-pill { opacity:1; }
.thumb-wrap:hover .duration-badge { opacity:0; }
.title-cell { display:flex; align-items:flex-start; gap:0.9rem; min-width:300px; }
.title-info { display:flex; flex-direction:column; gap:0.2rem; flex:1; min-width:0; }
.row-title { font-weight:650; color:var(--text); cursor:pointer; font-size:0.94rem; }
.row-title:hover { color:var(--title-hover); }
.row-sub { font-size:0.76rem; color:var(--muted); display:-webkit-box; -webkit-line-clamp:1; -webkit-box-orient:vertical; overflow:hidden; max-width:650px; }
.soundbite-list { display:flex; flex-direction:column; gap:0.3rem; margin-top:0.35rem; }
.soundbite-pill { display:inline-flex; align-items:center; gap:0.45rem; background:var(--sb-bg); border:1px solid var(--sb-border); color:var(--sb-text); padding:0.28rem 0.55rem; border-radius:0.4rem; font-size:0.76rem; cursor:pointer; width:fit-content; max-width:100%; }
.soundbite-pill:hover { background:var(--sb-hover-bg); border-color:var(--brand-accent); color:var(--sb-hover-text); }
.sb-time { background:var(--brand-primary); color:#ffffff; font-weight:700; font-size:0.7rem; padding:1px 6px; border-radius:3px; font-variant-numeric:tabular-nums; flex-shrink:0; pointer-events:none; }
.sb-text { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; pointer-events:none; }
mark.sb-hl { background:var(--hl-bg); color:var(--hl-text); font-weight:700; padding:0 3px; border-radius:2px; }
.mono-num { font-variant-numeric:tabular-nums; white-space:nowrap; color:var(--mono-text); font-weight:500; }
.cc-pill { display:inline-block; background:var(--cc-bg); border:1px solid var(--cc-border); color:var(--cc-text); font-size:0.66rem; padding:0px 6px; border-radius:4px; margin-left:6px; font-weight:700; vertical-align:middle; }
.grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(290px, 1fr)); gap:1.1rem; }
.card { background:var(--card); border:1px solid var(--border); border-radius:0.7rem; overflow:hidden; display:flex; flex-direction:column; transition:border-color 0.15s ease, transform 0.15s ease; }
.card:hover { border-color:var(--brand-accent); transform:translateY(-1px); }
.thumb-wrap { position:relative; aspect-ratio:16/9; background:#050a12; cursor:pointer; overflow:hidden; user-select:none; border-bottom:1px solid var(--border); }
.thumb-wrap img { width:100%; height:100%; object-fit:cover; display:block; pointer-events:none; }
.duration-badge { position:absolute; bottom:8px; right:8px; background:rgba(6,13,24,0.85); color:#ffffff; padding:2px 7px; border-radius:4px; font-size:0.74rem; font-weight:600; z-index:3; pointer-events:none; }
.transcript-badge { position:absolute; top:8px; left:8px; background:var(--brand-primary); border:1px solid rgba(255,255,255,0.45); color:#ffffff; padding:2px 7px; border-radius:4px; font-size:0.68rem; font-weight:700; z-index:3; pointer-events:none; }
.card-body { padding:0.9rem; display:flex; flex-direction:column; gap:0.45rem; flex:1; min-width:0; }
.card-title { font-size:0.96rem; font-weight:650; color:var(--text); cursor:pointer; }
.card-title:hover { color:var(--title-hover); }
.card-meta-row { display:flex; gap:0.75rem; font-size:0.75rem; color:var(--muted); flex-wrap:wrap; margin-top:0.2rem; }
.card-footer { margin-top:auto; padding-top:0.65rem; border-top:1px solid var(--row-border); display:flex; flex-direction:column; gap:0.5rem; font-size:0.75rem; color:var(--muted); }
.card-dates { display:flex; justify-content:space-between; width:100%; }
.action-group { display:flex; gap:0.38rem; flex-wrap:wrap; align-items:center; }
.btn { background:var(--brand-primary); color:#ffffff; border:1px solid rgba(255,255,255,0.2); padding:0.4rem 0.78rem; border-radius:0.4rem; font-size:0.78rem; cursor:pointer; text-decoration:none; display:inline-flex; align-items:center; justify-content:center; gap:0.35rem; white-space:nowrap; font-weight:600; transition:filter 0.14s ease, background 0.14s ease; }
.btn:hover { filter:brightness(1.12); }
.btn-lg { padding:0.58rem 1.15rem; font-size:0.88rem; }
.btn-secondary { background:var(--btn-sec-bg); border:1px solid var(--btn-sec-border); color:var(--btn-sec-text); }
.btn-secondary:hover { background:var(--btn-sec-hover-bg); color:var(--btn-sec-hover-text); filter:none; }
.btn-danger { background:rgba(220,38,38,0.12); border:1px solid rgba(220,38,38,0.35); color:#ef4444; }
.btn-danger:hover { background:#dc2626; color:#ffffff; filter:none; }
.btn-dl { background:var(--btn-dl-bg); color:var(--btn-dl-text); border:1px solid var(--btn-dl-border); }
.btn-dl:hover { background:var(--btn-dl-hover-bg); border-color:var(--btn-dl-hover-bg); color:var(--btn-dl-hover-text); filter:none; }
.btn-copied { background:#059669 !important; border-color:#059669 !important; color:#ffffff !important; }
.btn-capture { background:var(--brand-accent); border:1px solid var(--brand-accent); color:var(--btn-cap-text); padding:0.42rem 0.85rem; font-size:0.8rem; font-weight:700; }

.pagination-bar { margin-top:1.15rem; padding:0.75rem 1rem; background:var(--panel); border:1px solid var(--border); border-radius:0.55rem; display:flex; flex-wrap:wrap; gap:0.75rem; align-items:center; justify-content:space-between; flex-shrink:0; }
.page-status { font-size:0.82rem; color:var(--muted); font-variant-numeric:tabular-nums; }
.page-controls { display:flex; align-items:center; gap:0.32rem; flex-wrap:wrap; }
.page-btn { background:var(--page-btn-bg); color:var(--page-btn-text); border:1px solid var(--page-btn-border); min-width:36px; height:34px; padding:0 0.65rem; border-radius:0.38rem; font-size:0.8rem; font-weight:600; font-variant-numeric:tabular-nums; cursor:pointer; display:inline-flex; align-items:center; justify-content:center; }
.page-btn:hover:not(:disabled):not(.active) { background:var(--page-btn-hover-bg); border-color:var(--brand-accent); }
.page-btn.active { background:var(--page-btn-active-bg); border-color:var(--page-btn-active-bg); color:var(--page-btn-active-text); font-weight:700; cursor:default; }
.page-btn:disabled { opacity:0.42; cursor:not-allowed; }
.page-ellipsis { color:var(--muted); padding:0 0.3rem; font-size:0.85rem; user-select:none; }
.empty-state { padding:2.5rem 1rem; text-align:center; color:var(--muted); font-size:0.92rem; }

/* Modals */
.modal-backdrop { position:fixed; inset:0; background:rgba(8,14,24,0.78); display:none; align-items:center; justify-content:center; padding:1rem; z-index:100; backdrop-filter:blur(3px); }
.modal-backdrop.open { display:flex; }
.modal { background:var(--panel); border:1px solid var(--border); border-top:4px solid var(--modal-top-border); border-radius:0.75rem; max-width:1060px; width:100%; max-height:94vh; max-height:92dvh; display:flex; flex-direction:column; overflow:hidden; box-shadow:0 24px 55px rgba(0,0,0,0.45); }
.modal-md { max-width:660px; }
.modal-header { background:var(--modal-head-bg); padding:0.85rem 1.15rem; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; gap:0.65rem; flex-wrap:wrap; }
.modal-title-wrap { display:flex; flex-direction:column; gap:0.15rem; flex:1; min-width:160px; overflow:hidden; }
.modal-header h2 { font-size:1.02rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--modal-title-text); font-weight:700; }
.modal-file-sub { font-size:0.75rem; color:var(--muted); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.modal-actions { display:flex; align-items:center; gap:0.4rem; flex-shrink:0; flex-wrap:wrap; }
.close-btn { background:transparent; border:none; color:var(--muted); font-size:1.7rem; cursor:pointer; line-height:1; padding:0 0.3rem; }
.modal-body { padding:1rem 1.15rem; overflow-y:auto; -webkit-overflow-scrolling:touch; display:flex; flex-direction:column; gap:0.85rem; }
.player-wrap { aspect-ratio:16/9; width:100%; background:#000; border-radius:0.5rem; overflow:hidden; position:relative; display:flex; align-items:center; justify-content:center; border:1px solid var(--border); flex-shrink:0; }
.player-wrap iframe, .player-wrap video { width:100%; height:100%; border:0; display:block; background:#000; }
.stream-loader { color:var(--brand-accent); font-size:0.88rem; font-weight:500; text-align:center; padding:1rem; }
.frame-controls-bar { background:var(--frame-bar-bg); border:1px solid var(--border); border-radius:0.5rem; padding:0.55rem 0.85rem; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:0.65rem; }
.frame-btn-group { display:flex; align-items:center; gap:0.38rem; flex-wrap:wrap; }
.btn-frame { background:var(--frame-btn-bg); color:var(--frame-btn-text); border:1px solid var(--frame-btn-border); padding:0.38rem 0.68rem; border-radius:0.38rem; font-size:0.78rem; font-weight:600; cursor:pointer; font-variant-numeric:tabular-nums; }
.btn-frame:hover { background:var(--brand-primary); border-color:var(--brand-accent); color:#ffffff; }
.frame-readout { font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-size:0.78rem; color:var(--readout-text); background:var(--readout-bg); border:1px solid var(--readout-border); padding:0.28rem 0.65rem; border-radius:0.35rem; white-space:nowrap; font-weight:700; }
.frame-hint { font-size:0.74rem; color:var(--muted); }
.capture-status { font-size:0.78rem; color:var(--status-ok); font-weight:700; }
.transcript-box { background:var(--tbox-bg); border:1px solid var(--border); border-radius:0.5rem; padding:0.6rem; max-height:220px; overflow-y:auto; -webkit-overflow-scrolling:touch; font-size:0.84rem; color:var(--tbox-text); display:flex; flex-direction:column; gap:0.25rem; }
.t-seg { display:flex; gap:0.65rem; align-items:baseline; padding:0.35rem 0.5rem; border-left:3px solid transparent; border-radius:0.35rem; cursor:pointer; }
.t-seg:hover { background:var(--tseg-hover-bg); color:var(--tseg-hover-text); }
.t-seg.active-cue { background:var(--tseg-active-bg); border-left-color:var(--tseg-active-border); color:var(--text); font-weight:600; }
.t-seg-time { color:var(--brand-accent-text); font-weight:700; font-size:0.75rem; font-variant-numeric:tabular-nums; flex-shrink:0; min-width:42px; pointer-events:none; }
.t-seg-text { pointer-events:none; }
.export-card { background:var(--bg); border:1px solid var(--border); border-radius:0.55rem; padding:0.9rem 1rem; display:flex; flex-direction:column; gap:0.55rem; }
.export-card h4 { font-size:0.9rem; color:var(--text); }
.export-card p { font-size:0.79rem; color:var(--muted); }

/* Mobile & iPhone Responsive Optimizations */
@media (max-width: 760px) {
  header { padding:calc(0.65rem + env(safe-area-inset-top)) 0.9rem 0.7rem; gap:0.6rem; }
  .brand h1 { font-size:1.08rem; }
  .brand p { font-size:0.71rem; }
  .controls { width:100%; justify-content:space-between; gap:0.42rem; }
  .search-wrap { flex:1 1 100%; order:1; min-width:100%; }
  #sortSelect { flex:1 1 auto; order:2; min-width:0; max-width:48%; }
  .view-toggle { order:3; }
  #themeToggleBtn { order:4; padding:0.48rem 0.62rem; }
  #syncNowBtn { order:5; padding:0.48rem 0.72rem; }
  #settingsOpenBtn { order:6; padding:0.48rem 0.62rem; }
  .search-kbd, .frame-hint { display:none !important; }

  /* 16px font-size prevents iOS Safari from auto-zooming the viewport on focus */
  .search-wrap input[type="search"],
  select,
  .field-group input[type="text"],
  .field-group input[type="password"] { font-size:16px !important; }

  main.content { padding:0.8rem 0.85rem calc(1.5rem + env(safe-area-inset-bottom)); }
  .wizard-wrap { padding:1.2rem 1.1rem; margin:0.25rem auto; }
  .brand-row { grid-template-columns:1fr 1fr; }
  .brand-row .field-group { grid-column:1 / -1; }
  .wizard-footer .btn-lg { width:100%; }
  .grid { grid-template-columns:1fr; gap:0.9rem; }
  .pagination-bar { justify-content:center; text-align:center; }
  .page-controls { justify-content:center; width:100%; }

  .modal-backdrop { padding:0.45rem; }
  .modal { max-height:95dvh; border-radius:0.65rem; }
  .modal-header { padding:0.7rem 0.85rem; }
  .modal-body { padding:0.8rem 0.85rem; }
  .modal-actions { width:100%; justify-content:flex-start; }
  .frame-controls-bar { justify-content:center; padding:0.5rem; }
  .frame-btn-group { width:100%; justify-content:space-between; }
  .btn-frame { flex:1; text-align:center; padding:0.42rem 0.35rem; font-size:0.74rem; }
}
</style>
</head>
<body>
<header>
  <div class="brand">
    <h1 id="brandHeading">Vimeo Video Directory</h1>
    <p>
      <span id="syncInfo">Setup required</span>
      <span id="deltaBadge" class="delta-pill"></span>
    </p>
  </div>
  <div class="controls" id="headerControls" style="display:none;">
    <div class="search-wrap" id="searchWrap">
      <input type="search" id="searchInput" placeholder="Search videos, soundbites, or tags...">
      <span class="search-kbd">/</span>
      <button type="button" class="search-clear-btn" id="searchClearBtn" title="Clear search">&times;</button>
    </div>
    <select id="sortSelect">
      <option value="created:desc">Newest First</option>
      <option value="created:asc">Oldest First</option>
      <option value="modified:desc">Modified: Newest</option>
      <option value="modified:asc">Modified: Oldest</option>
      <option value="size:desc">Size: Largest</option>
      <option value="size:asc">Size: Smallest</option>
      <option value="duration:desc">Longest</option>
      <option value="duration:asc">Shortest</option>
      <option value="views:desc">Most Viewed</option>
      <option value="views:asc">Least Viewed</option>
      <option value="title:asc">Title: A–Z</option>
      <option value="title:desc">Title: Z–A</option>
    </select>
    <div class="view-toggle">
      <button class="view-btn active" id="listViewBtn">☰ List</button>
      <button class="view-btn" id="gridViewBtn">⊞ Grid</button>
    </div>
    <button class="header-util-btn" id="themeToggleBtn" title="Switch between Light Mode and Dark Mode">☾</button>
    <button class="sync-btn" id="syncNowBtn" title="Pull latest Vimeo uploads & captions"><span class="spin-icon">↻</span> <span id="syncBtnLabel">Sync</span></button>
    <button class="header-util-btn" id="settingsOpenBtn" title="Directory Settings, Branding & HTML Export">⚙</button>
  </div>
</header>

<main class="content" id="mainScrollArea">
  <!-- First-Time Setup Wizard -->
  <section class="wizard-wrap" id="setupWizard">
    <div class="wizard-head">
      <h2>Connect Your Vimeo Library</h2>
      <p>Build a fast, searchable video &amp; soundbite directory directly in your browser on desktop or mobile.</p>
    </div>

    <div class="wizard-steps">
      <div class="w-step">
        <span class="w-num">1</span>
        <div class="w-body">
          Open <a href="https://developer.vimeo.com/apps/new" target="_blank" rel="noopener">developer.vimeo.com/apps/new</a>, enter any App Name (e.g., <strong>Video Directory</strong>), select <strong>No</strong> for external account access, and click <strong>Create App</strong>.
        </div>
      </div>
      <div class="w-step">
        <span class="w-num">2</span>
        <div class="w-body">
          Scroll down to <strong>Generate an Access Token</strong>, choose <strong>Authenticated (you)</strong>, check these three read-only scopes, and click <strong>Generate</strong>:
          <div class="scope-pills">
            <span class="scope-pill">✓ Public</span>
            <span class="scope-pill">✓ Private</span>
            <span class="scope-pill">✓ Video Files</span>
          </div>
        </div>
      </div>
      <div class="w-step">
        <span class="w-num">3</span>
        <div class="w-body">
          Paste your token below, customize your title &amp; brand colors, and tap <strong>Connect &amp; Build Directory</strong>.
        </div>
      </div>
    </div>

    <div class="wizard-grid">
      <div class="field-group">
        <label for="wizTokenInput">Vimeo Personal Access Token (Read-Only)</label>
        <input type="password" id="wizTokenInput" placeholder="Paste your 32-character Vimeo token..." autocomplete="off">
      </div>
      <div class="brand-row">
        <div class="field-group">
          <label for="wizTitleInput">Directory Title</label>
          <input type="text" id="wizTitleInput" value="Vimeo Video Directory" placeholder="e.g., Kirkwood Video Directory">
        </div>
        <div class="field-group">
          <label for="wizFileNameInput">HTML File Name</label>
          <div class="filename-input-wrap">
            <input type="text" id="wizFileNameInput" value="Vimeo Video Directory" placeholder="Kirkwood Video Directory">
            <span class="filename-ext">.html</span>
          </div>
        </div>
        <div class="color-pick-wrap">
          <label style="font-size:0.8rem;font-weight:650;">Primary</label>
          <div class="color-pick-box">
            <input type="color" id="wizPrimaryColor" value="#005399">
            <span id="wizPrimaryHex">#005399</span>
          </div>
        </div>
        <div class="color-pick-wrap">
          <label style="font-size:0.8rem;font-weight:650;">Accent</label>
          <div class="color-pick-box">
            <input type="color" id="wizAccentColor" value="#00aeef">
            <span id="wizAccentHex">#00aeef</span>
          </div>
        </div>
      </div>

      <label class="auto-save-check" for="wizAutoExportCheck">
        <input type="checkbox" id="wizAutoExportCheck">
        <span>Also download a standalone <strong id="wizAutoExportNamePreview">Vimeo Video Directory.html</strong> desktop file when sync finishes</span>
      </label>
    </div>

    <div class="wizard-progress" id="wizProgressWrap">
      <div class="prog-text" id="wizProgressLabel">Verifying Vimeo token...</div>
      <div class="prog-bar-track"><div class="prog-bar-fill" id="wizProgressBar"></div></div>
    </div>

    <div class="wizard-status" id="wizStatusMsg"></div>

    <div class="wizard-footer">
      <span class="privacy-note">🔒 Your token &amp; catalog stay 100% inside this device's private browser storage and only ever talk directly to <code>api.vimeo.com</code>.</span>
      <button type="button" class="btn btn-lg" id="wizConnectBtn">Connect &amp; Build Directory →</button>
    </div>
  </section>

  <!-- Active Directory Workspace -->
  <div id="directoryWorkspace" style="display:none; flex-direction:column;">
    <div class="stats-bar">
      <span id="resultCount">Loading...</span>
      <label class="per-page-wrap">
        <span>Show</span>
        <select id="perPageSelect" class="per-page-select">
          <option value="25">25</option>
          <option value="50" selected>50</option>
          <option value="100">100</option>
          <option value="250">250</option>
        </select>
        <span>per page</span>
      </label>
    </div>
    <div id="listContainer" class="table-wrap">
      <table class="video-table">
        <thead>
          <tr>
            <th data-field="title" data-default-dir="asc">Video / Title <span class="sort-arrow"></span></th>
            <th data-field="duration" data-default-dir="desc">Duration <span class="sort-arrow"></span></th>
            <th data-field="size" data-default-dir="desc">Upload Size <span class="sort-arrow"></span></th>
            <th data-field="views" data-default-dir="desc">Views <span class="sort-arrow"></span></th>
            <th data-field="created" data-default-dir="desc">Uploaded <span class="sort-arrow"></span></th>
            <th data-field="modified" data-default-dir="desc">Modified <span class="sort-arrow"></span></th>
            <th style="cursor:default;">Actions</th>
          </tr>
        </thead>
        <tbody id="videoTableBody"></tbody>
      </table>
    </div>
    <div id="gridContainer" class="grid" style="display:none;"></div>
    <div id="emptyState" class="empty-state" style="display:none;">No matching videos found.</div>
    <div id="paginationBar" class="pagination-bar" style="display:none;">
      <span id="pageStatus" class="page-status"></span>
      <div id="pageControls" class="page-controls"></div>
    </div>
  </div>
</main>

<!-- Video Player Modal -->
<div class="modal-backdrop" id="videoModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title-wrap">
        <h2 id="modalTitle">Video</h2>
        <span id="modalFileSub" class="modal-file-sub" style="display:none;"></span>
      </div>
      <button class="close-btn" id="closeModal">&times;</button>
      <div class="modal-actions">
        <span id="captureStatus" class="capture-status"></span>
        <button class="btn btn-secondary" id="modalCopyUrlBtn">Copy URL</button>
        <button class="btn btn-secondary" id="modalCopyEmbedBtn">Copy Embed</button>
        <button class="btn btn-dl" id="modalDownloadMp4Btn" style="display:none;" title="Download highest-resolution source .MP4 file">⬇ MP4</button>
        <button class="btn btn-dl" id="modalDownloadSrtBtn" style="display:none;" title="Download SubRip .SRT caption file">⬇ SRT</button>
        <button class="btn btn-dl" id="modalDownloadTxtBtn" style="display:none;" title="Download plain-text .TXT transcript">⬇ TXT</button>
        <button class="btn btn-capture" id="captureStillBtn" title="Download a full-resolution .JPG still of the current video frame">📸 Still (.JPG)</button>
      </div>
    </div>
    <div class="modal-body">
      <div class="player-wrap" id="modalPlayer"></div>
      <div class="frame-controls-bar">
        <div class="frame-btn-group">
          <button class="btn-frame" id="stepBack10Btn">⏮ -10f</button>
          <button class="btn-frame" id="stepBack1Btn">◀ -1f</button>
          <button class="btn-frame" id="stepPlayPauseBtn">⏯ Play</button>
          <button class="btn-frame" id="stepFwd1Btn">+1f ▶</button>
          <button class="btn-frame" id="stepFwd10Btn">+10f ⏭</button>
        </div>
        <div class="frame-readout" id="frameReadout">0:00.00 • Frame 0</div>
