  document.getElementById("stepBack1Btn").addEventListener("click", () => stepFrames(-1));
  document.getElementById("stepPlayPauseBtn").addEventListener("click", toggleModalPlayPause);
  document.getElementById("stepFwd1Btn").addEventListener("click", () => stepFrames(1));
  document.getElementById("stepFwd10Btn").addEventListener("click", () => stepFrames(10));

  function goToCatalogPage(nextP) {
    const totalPages = Math.max(1, Math.ceil(currentFiltered.length / pageSize));
    const clamped = Math.max(1, Math.min(totalPages, nextP));
    if (clamped !== currentPage) {
      currentPage = clamped;
      renderCurrentPage();
      mainScrollArea.scrollTo({ top: 0, behavior: "smooth" });
    }
  }

  window.addEventListener("keydown", e => {
    const tag = document.activeElement?.tagName || "";
    const inInput = (tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT");

    if (settingsModal.classList.contains("open")) {
      if (e.key === "Escape") settingsModal.classList.remove("open");
      return;
    }
    if (setupWizard.style.display !== "none") return;

    if (!videoModal.classList.contains("open")) {
      if (e.key === "/" && !inInput) {
        e.preventDefault();
        searchInput.focus();
        searchInput.select();
      } else if (e.key === "Escape" && document.activeElement === searchInput && searchInput.value) {
        searchInput.value = "";
        render(true);
      } else if (!inInput && !e.metaKey && !e.ctrlKey && !e.altKey) {
        if (e.key === "ArrowLeft" || e.key === "[") { e.preventDefault(); goToCatalogPage(currentPage - 1); }
        else if (e.key === "ArrowRight" || e.key === "]") { e.preventDefault(); goToCatalogPage(currentPage + 1); }
      }
      return;
    }

    if (inInput) return;
    if (e.key === "ArrowLeft") { e.preventDefault(); stepFrames(e.shiftKey ? -10 : -1); }
    else if (e.key === "ArrowRight") { e.preventDefault(); stepFrames(e.shiftKey ? 10 : 1); }
    else if (e.key === ",") { e.preventDefault(); stepFrames(-1); }
    else if (e.key === ".") { e.preventDefault(); stepFrames(1); }
    else if (e.key === " ") { e.preventDefault(); toggleModalPlayPause(); }
    else if (e.key === "Escape") { closeVideoModal(); }
  });

  const previewCtrl = {
    el: null, vid: null, timer: null, abort: null, mediaEl: null,
    isDragging: false, isSeeking: false, pendingTime: null, lastIframeSeek: 0, rafId: 0
  };

  function teardownActivePreview() {
    if (previewCtrl.rafId) { cancelAnimationFrame(previewCtrl.rafId); previewCtrl.rafId = 0; }
    if (previewCtrl.timer) { clearTimeout(previewCtrl.timer); previewCtrl.timer = null; }
    if (previewCtrl.abort) { previewCtrl.abort.abort(); previewCtrl.abort = null; }
    if (previewCtrl.mediaEl) {
      if (previewCtrl.mediaEl.tagName === "VIDEO") {
        previewCtrl.mediaEl.pause();
        previewCtrl.mediaEl.removeAttribute("src");
        previewCtrl.mediaEl.load();
      }
      previewCtrl.mediaEl.remove();
      previewCtrl.mediaEl = null;
    }
    if (previewCtrl.el) {
      const fill = previewCtrl.el.querySelector(".scrub-fill");
      if (fill) fill.style.width = "0%";
      previewCtrl.el._scrubTime = 0;
    }
    previewCtrl.el = null;
    previewCtrl.vid = null;
    previewCtrl.isSeeking = false;
    previewCtrl.pendingTime = null;
  }

  function updateThumbScrubUI(thumbEl, v, curSec) {
    const dur = Number(v.duration) || (previewCtrl.mediaEl?.duration) || 0;
    if (!dur) return;
    const ratio = Math.max(0, Math.min(1, curSec / dur));
    const fill = thumbEl.querySelector(".scrub-fill");
    const pill = thumbEl.querySelector(".scrub-time-pill");
    if (fill) fill.style.width = `${(ratio * 100).toFixed(1)}%`;
    if (pill) pill.textContent = `${formatDuration(curSec)} / ${v._durStr}`;
    thumbEl._scrubTime = curSec;
  }

  async function mountHoverMedia(thumbEl, v) {
    if (previewCtrl.el !== thumbEl || previewCtrl.mediaEl || previewCtrl.abort) return;
    ensureVideoIndexed(v);
    const ctrl = new AbortController();
    previewCtrl.abort = ctrl;
    const streams = await resolveFreshStreams(v, ctrl.signal);
    if (previewCtrl.abort === ctrl) previewCtrl.abort = null;
    if (previewCtrl.el !== thumbEl || previewCtrl.mediaEl) return;

    const mp4Url = streams.previewMp4 || streams.bestMp4;
    if (mp4Url) {
      const vid = document.createElement("video");
      vid.className = "hover-preview-el";
      vid.src = mp4Url;
      vid.muted = true; vid.loop = true; vid.playsInline = true; vid.preload = "auto"; vid.autoplay = true;
      vid.addEventListener("loadedmetadata", () => { if (thumbEl._scrubTime > 0) vid.currentTime = thumbEl._scrubTime; }, { once: true });
      vid.addEventListener("timeupdate", () => { if (!previewCtrl.isDragging && previewCtrl.el === thumbEl) updateThumbScrubUI(thumbEl, v, vid.currentTime || 0); });
      vid.addEventListener("seeking", () => { previewCtrl.isSeeking = true; });
      vid.addEventListener("seeked", () => {
        previewCtrl.isSeeking = false;
        if (previewCtrl.pendingTime !== null && previewCtrl.mediaEl === vid) {
          const t = previewCtrl.pendingTime;
          previewCtrl.pendingTime = null;
          vid.currentTime = t;
        }
      });
      thumbEl.appendChild(vid);
      vid.play().catch(() => {});
      previewCtrl.mediaEl = vid;
    } else if (v.embed) {
      const ifr = document.createElement("iframe");
      ifr.className = "hover-preview-el";
      const sep = v.embed.includes("?") ? "&" : "?";
      ifr.src = `${v.embed}${sep}background=1&autoplay=1&muted=1&loop=1&autopause=0&api=1`;
      ifr.allow = "autoplay";
      thumbEl.appendChild(ifr);
      previewCtrl.mediaEl = ifr;
    }
  }

  function scrubActiveThumbAtClientX(clientX) {
    const thumbEl = previewCtrl.el, v = previewCtrl.vid;
    if (!thumbEl || !v) return;
    const rect = thumbEl.getBoundingClientRect();
    if (!rect.width) return;
    const ratio = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
    const dur = Number(v.duration) || (previewCtrl.mediaEl?.duration) || 0;
    const targetSec = ratio * dur;
    updateThumbScrubUI(thumbEl, v, targetSec);
    mountHoverMedia(thumbEl, v);

    const media = previewCtrl.mediaEl;
    if (media?.tagName === "VIDEO" && dur > 0 && media.readyState >= 1) {
      if (!previewCtrl.isSeeking) media.currentTime = targetSec;
      else previewCtrl.pendingTime = targetSec;
    } else if (media?.tagName === "IFRAME" && dur > 0) {
      const now = performance.now();
      if (now - previewCtrl.lastIframeSeek > 110 && media.contentWindow) {
        previewCtrl.lastIframeSeek = now;
        media.contentWindow.postMessage(JSON.stringify({ method: "setCurrentTime", value: Math.floor(targetSec) }), "*");
      }
    }
  }

  mainScrollArea.addEventListener("pointerover", e => {
    if (e.pointerType === "touch" || previewCtrl.isDragging) return;
    const thumbEl = e.target.closest(".row-thumb, .thumb-wrap");
    if (thumbEl === previewCtrl.el) return;
    teardownActivePreview();
    if (!thumbEl) return;
    const v = videoById.get(thumbEl.dataset.vid);
    if (!v) return;
    previewCtrl.el = thumbEl;
    previewCtrl.vid = v;
    previewCtrl.timer = setTimeout(() => mountHoverMedia(thumbEl, v), 150);
  });

  mainScrollArea.addEventListener("pointerout", e => {
