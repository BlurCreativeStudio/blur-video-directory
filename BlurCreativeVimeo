  async function runSilentDeltaCheck() {
    if (!activeToken || isFullSyncRunning) return;
    try {
      const lastCheck = parseInt(sessionStorage.getItem("vvd_last_delta_ts") || "0", 10);
      if (Date.now() - lastCheck < DELTA_COOLDOWN_MS) return;
      sessionStorage.setItem("vvd_last_delta_ts", String(Date.now()));
    } catch {}

    try {
      const data = await vimeoFetch(`/me/videos?per_page=25&sort=date&direction=desc&fields=${SYNC_FIELDS}`);
      if (isFullSyncRunning || !data.data?.length) return;

      ensureAllVideosIndexed();
      const existingMap = new Map(videos.map(v => [String(v.id), v]));
      let addedCount = 0, updatedCount = 0;

      for (const item of data.data) {
        const id = (item.uri || "").split("/").pop();
        if (!id) continue;
        const mod = item.modified_time || item.created_time || "";
        const prev = existingMap.get(id);
        const freshFn = extractFilenameFromApiObj(item);

        if (!prev || (prev.modified || prev.created) !== mod || (freshFn && !prev.filename)) {
          const ttConn = item.metadata?.connections?.texttracks || {};
          const transcript = (!prev || (prev.modified || prev.created) !== mod) && ttConn.total > 0 && ttConn.uri
            ? await downloadTimedTranscriptForItem(ttConn.uri)
            : (prev?.transcript || "");
          existingMap.set(id, buildVideoEntryFromApi(item, prev, transcript));
          prev ? updatedCount++ : addedCount++;
        } else {
          prev.views = Number(item.stats?.plays) || prev.views;
        }
      }

      if ((addedCount > 0 || updatedCount > 0) && !isFullSyncRunning) {
        await commitUpdatedCatalog(Array.from(existingMap.values()));
        render(false);
        if (addedCount > 0) {
          deltaBadge.style.display = "inline-block";
          deltaBadge.textContent = `+${addedCount} new`;
        }
      }
    } catch {}
  }

  function escapeHtml(str) {
    return (str || "").replace(/[&<>"']/g, c => HTML_ESCAPES[c]);
  }

  function compileSearchQuery(rawQuery) {
    const raw = (rawQuery || "").trim().toLowerCase();
    if (!raw) return { raw: "", remainingRaw: "", phrases: [], tokens: [], regex: null, adIntent: false, targetSec: null, minSec: 0, maxSec: 0, userAskedForNonAd: false };

    let working = raw;
    const phrases = [];
    working = working.replace(/"([^"]+)"/g, (_, inner) => {
      const p = inner.trim();
      if (p) phrases.push(p);
      return " ";
    });

    let targetSec = null, adIntent = false;
    const colonOrUnderscoreMatch = working.match(/(?:^|\s)(?:(?:0?:|_)(0?6|10|15|20|30|45|60|90)|0?:(\d{1,2})|(\d):(\d{2}))(?=\s|$)/);
    if (colonOrUnderscoreMatch) {
      const parsed = colonOrUnderscoreMatch[1] !== undefined
        ? parseInt(colonOrUnderscoreMatch[1], 10)
        : (colonOrUnderscoreMatch[2] !== undefined
            ? parseInt(colonOrUnderscoreMatch[2], 10)
            : (parseInt(colonOrUnderscoreMatch[3], 10) * 60 + parseInt(colonOrUnderscoreMatch[4], 10)));
      if (parsed > 0 && parsed <= 180) {
        targetSec = parsed;
        adIntent = true;
        working = working.replace(colonOrUnderscoreMatch[0], " ");
      }
    }

    if (targetSec === null) {
      const wordDurMatch = working.match(/(?:^|\s)[:_]?(\d{1,3})[\s\-]*(?:seconds?|secs?|s)(?=\s|$)/i);
      if (wordDurMatch) {
        const parsed = parseInt(wordDurMatch[1], 10);
        if (parsed > 0 && parsed <= 180) {
          targetSec = parsed;
          adIntent = true;
          working = working.replace(wordDurMatch[0], " ");
        }
      }
    }

    AD_INTENT_WORDS_RE.lastIndex = 0;
    if (AD_INTENT_WORDS_RE.test(working)) {
      adIntent = true;
      working = working.replace(AD_INTENT_WORDS_RE, " ");
    }

    if (adIntent && targetSec === null) {
      const bareNumMatch = working.match(/(?:^|\s)(\d{1,3})(?=\s|$)/);
      if (bareNumMatch) {
        const parsed = parseInt(bareNumMatch[1], 10);
        if (parsed > 0 && parsed <= 120) {
          targetSec = parsed;
          working = working.replace(bareNumMatch[0], " ");
        }
      }
    }

    const unquotedClean = working.replace(/"/g, " ").replace(/\s+/g, " ").trim();
    const tokens = unquotedClean ? unquotedClean.split(/\s+/).filter(Boolean) : [];
    const remainingRaw = [...phrases, unquotedClean].filter(Boolean).join(" ").trim();
    const userAskedForNonAd = NON_AD_META_RE.test(remainingRaw);

    let minSec = 0, maxSec = 0;
    if (targetSec !== null) {
      const tol = targetSec <= 10 ? 1 : 2;
      minSec = Math.max(1, targetSec - tol);
      maxSec = targetSec + tol;
    }

    const highlightTerms = [...phrases, unquotedClean, ...tokens].filter((v, idx, arr) => v && v.length >= 2 && arr.indexOf(v) === idx);
    if (targetSec !== null) {
      const pad2 = String(targetSec).padStart(2, "0");
      highlightTerms.push(`:${pad2}`, `:${targetSec}`, `${targetSec}s`, `${targetSec}-second`, `${targetSec} second`);
    }
    highlightTerms.sort((a, b) => b.length - a.length);

    const escapedPatterns = highlightTerms.map(s => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"));
    return {
      raw, remainingRaw, phrases, tokens,
      regex: escapedPatterns.length ? new RegExp(`(${escapedPatterns.join("|")})`, "gi") : null,
      adIntent, targetSec, minSec, maxSec, userAskedForNonAd
    };
  }

  function matchesAdAndDurationFilter(v, qObj) {
    const dur = v.duration;
    if (qObj.targetSec !== null) {
      const matchesFnTag = v._fnSpotSec === qObj.targetSec;
      const matchesDurRange = dur >= qObj.minSec && dur <= qObj.maxSec;
      if (!matchesFnTag && !matchesDurRange) return false;
      if (!qObj.userAskedForNonAd && v._isNonAdMeta) return false;
    } else if (qObj.adIntent) {
      if (dur <= 0 || dur > 125) return false;
      if (!qObj.userAskedForNonAd && v._isNonAdMeta) return false;
      if (!v._hasAdMarker && !v._isStandardSpotDur) return false;
    }
    for (let i = 0; i < qObj.phrases.length; i++) if (!v._search.includes(qObj.phrases[i])) return false;
    for (let i = 0; i < qObj.tokens.length; i++) if (!v._search.includes(qObj.tokens[i])) return false;
    return true;
  }

  function scoreAdCandidate(v, qObj) {
    let score = 0;
    if (v._fnSpotSec !== null) {
      score += 8;
      if (qObj.targetSec !== null && v._fnSpotSec === qObj.targetSec) score += 6;
    }
    if (v._hasAdMarker) score += 4;
    if (qObj.targetSec !== null) {
      const pad2 = String(qObj.targetSec).padStart(2, "0");
      if (v._metaLower.includes(`:${pad2}`) || v._metaLower.includes(`_${pad2}`) || v._metaLower.includes(`${qObj.targetSec}s`)) score += 3;
      if (Math.abs(v.duration - qObj.targetSec) === 0) score += 2;
    }
    if (qObj.remainingRaw && (v._titleLower.includes(qObj.remainingRaw) || v._fileLower.includes(qObj.remainingRaw))) score += 4;
    return score;
  }

  function highlightQueryHtml(text, qObj) {
    const safe = escapeHtml(text);
    return qObj?.regex ? safe.replace(qObj.regex, '<mark class="sb-hl">$1</mark>') : safe;
  }

  function getTimedSegments(v) {
    if (v._segments) return v._segments;
    const raw = v.transcript || "";
    if (!raw) return (v._segments = []);
    const segs = [];
    for (const p of raw.split(/(?=~\d+\s)/)) {
      const m = p.match(/^~(\d+)\s+([\s\S]*)$/);
      const text = (m ? m[2] : p).trim();
      if (text) segs.push({ sec: m ? parseInt(m[1], 10) : 0, text, lower: text.toLowerCase() });
    }
    return (v._segments = segs);
  }

  function buildSrtFallbackFromSegments(segs) {
    const toSrtTime = sec => {
      const h = String(Math.floor(sec / 3600)).padStart(2, "0");
      const m = String(Math.floor((sec % 3600) / 60)).padStart(2, "0");
      const s = String(Math.floor(sec % 60)).padStart(2, "0");
      return `${h}:${m}:${s},000`;
    };
    return segs.map((seg, i) => {
      const nextSec = (i + 1 < segs.length) ? Math.max(seg.sec + 1, segs[i + 1].sec) : (seg.sec + 4);
      return `${i + 1}\n${toSrtTime(seg.sec)} --> ${toSrtTime(nextSec)}\n${seg.text}`;
    }).join("\n\n") + "\n";
  }

  function findSoundbiteMatches(v, qObj, maxHits = 3) {
    const primaryPhrase = qObj?.phrases?.[0] || qObj?.remainingRaw || "";
    if (!primaryPhrase || primaryPhrase.length < 2 || !v.transcript) return [];
    const segs = getTimedSegments(v);
    const exactHits = [], tokenHits = [];
    const makeSnippet = (text, idx, len) => {
      const start = Math.max(0, idx - 35);
      const end = Math.min(text.length, idx + len + 55);
      return (start > 0 ? "…" : "") + text.slice(start, end).trim() + (end < text.length ? "…" : "");
    };
    for (const seg of segs) {
      const exactIdx = seg.lower.indexOf(primaryPhrase);
      if (exactIdx !== -1) {
        exactHits.push({ sec: seg.sec, snippet: makeSnippet(seg.text, exactIdx, primaryPhrase.length) });
        if (exactHits.length >= maxHits) return exactHits;
      } else if (!qObj.phrases.length && qObj.tokens.length > 1 && tokenHits.length < maxHits && qObj.tokens.every(t => seg.lower.includes(t))) {
        tokenHits.push({ sec: seg.sec, snippet: makeSnippet(seg.text, seg.lower.indexOf(qObj.tokens[0]), 30) });
      }
    }
    return [...exactHits, ...tokenHits].slice(0, maxHits);
  }

  function getEmbedCode(v) {
    ensureVideoIndexed(v);
    return v.embedHtml || `<iframe src="${v.embed}" width="640" height="360" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>`;
  }

  function downloadTextBlob(content, filename, mimeType = "text/plain;charset=utf-8") {
    const blob = new Blob([content], { type: mimeType });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  }

  async function copyToClipboard(text, btnEl, originalLabel) {
    try {
      if (navigator.clipboard?.writeText) await navigator.clipboard.writeText(text);
      else {
        const ta = document.createElement("textarea");
        ta.value = text;
        ta.style.cssText = "position:fixed;opacity:0";
        document.body.appendChild(ta);
        ta.select();
        document.execCommand("copy");
        ta.remove();
      }
      if (btnEl) {
        btnEl.textContent = "✓ Copied!";
        btnEl.classList.add("btn-copied");
        setTimeout(() => { btnEl.textContent = originalLabel; btnEl.classList.remove("btn-copied"); }, 1400);
      }
    } catch {}
  }

