<script id="appLogicScript">
const INITIAL_BODY_MARKUP = document.body.innerHTML.split('<script id="bakedConfigScript">')[0].trim();

const THUMB_PREFIX = "https://i.vimeocdn.com/video/";
const LINK_PREFIX = "https://vimeo.com/";
const EMBED_PREFIX = "https://player.vimeo.com/video/";
const DELTA_COOLDOWN_MS = 10 * 60 * 1000;
const TITLE_COLLATOR = new Intl.Collator("en", { numeric: true, sensitivity: "base" });
const IS_MOBILE_SCREEN = window.matchMedia && window.matchMedia("(max-width: 760px)").matches;

const SYNC_FIELDS = "uri,name,description,link,player_embed_url,embed.html,duration,created_time,modified_time,pictures.base_link,tags.name,privacy.view,stats.plays,current_version.filename,files.size,files.rendition,files.width,files.fps,download.rendition,download.link,upload.size,metadata.connections.texttracks";
const STREAM_FIELDS = "current_version.filename,files.link,files.width,files.height,files.type,files.rendition,files.fps,download.link,download.width,download.size,download.rendition,download.type,metadata.connections.texttracks";
const VALID_MP4_RENDITIONS = new Set(["2160p", "1440p", "1080p", "720p", "540p", "360p", "240p"]);
const HTML_ESCAPES = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" };

const FILENAME_SPOT_TAG_RE = /(?:^|[_\-\s])(0?6|10|15|20|30|45|60|90)s?(?=[_\-\s.]|$)/i;
const POSITIVE_AD_RE = /(?:^|[\s_\-([/])(?::0?6|:10|:15|:20|:30|:45|:60|:90|0?6s|10s|15s|30s|60s|15\s*sec|30\s*sec|60\s*sec|tv|tv\s*ad|tv\s*spot|spot|commercial|broadcast|ott|ctv|pre[\s\-]?roll|paid\s*media|isci)(?:$|[\s_\-)\],.])/i;
const NON_AD_META_RE = /\b(?:b[\s\-]?roll|broll|raw|rough\s*cut|stringout|selects|interview|soundbite|testimonial\s*full|zoom|webinar|lecture|seminar|workshop|panel|meeting|board\s*of\s*trustees|commencement|graduation|ceremony|convocation|keynote|livestream|live\s*stream|podcast|tutorial|how[\s\-]?to|walkthrough|training|orientation|screen\s*recording|screencast|recap|highlights?|behind\s*the\s*scenes|bts|bloopers?|outtakes?)\b/i;
const AD_INTENT_WORDS_RE = /\b(?:tv\s+ads?|tv\s+spots?|tv\s+commercials?|commercials?|broadcast\s+ads?|broadcast\s+spots?|video\s+ads?|ad\s+spots?|tv|ads?|spots?|broadcast|ott|ctv|pre[\s\-]?roll)\b/gi;
const STANDARD_SPOT_LENGTHS = [6, 10, 15, 20, 30, 45, 60, 90];

let activeToken = "";
let activeConfig = {
  title: "Vimeo Video Directory",
  exportFileName: "Vimeo Video Directory",
  primary: "#005399",
  accent: "#00aeef",
  accountName: ""
};
const streamSessionCache = new Map();
const streamInFlight = new Map();

function cleanHtmlBaseName(raw, fallback = "Vimeo Video Directory") {
  const stripped = (raw || "").trim().replace(/\.html?$/i, "").replace(/[<>:"/\\|?*\x00-\x1F]/g, "").trim();
  return stripped || fallback;
}

function buildFaviconDataUri(primary, accent) {
