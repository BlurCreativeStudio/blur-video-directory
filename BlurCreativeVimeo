    }
  }

  function stepFrames(frameCount) {
    if (!activeModalVideo) return;
    const fps = Number(activeModalVideo.fps) || 29.97;
    const frameDur = 1 / fps;
    const vidEl = modalPlayer.querySelector("video");
    if (vidEl) {
      if (!vidEl.paused) vidEl.pause();
      const maxDur = vidEl.duration || activeModalVideo.duration || 999999;
      const targetFrame = Math.max(0, Math.round((vidEl.currentTime || 0) * fps) + frameCount);
      const nextTime = Math.min(maxDur, Math.max(0, (targetFrame * frameDur) + 0.0001));
      vidEl.currentTime = nextTime;
      updateFrameReadout(nextTime);
      return;
    }
    const ifrEl = modalPlayer.querySelector("iframe");
    if (ifrEl?.contentWindow) {
      ifrEl.contentWindow.postMessage(JSON.stringify({ method: "pause" }), "*");
      iframeIsPaused = true;
      iframeTrackedTime = Math.min(activeModalVideo.duration || 999999, Math.max(0, iframeTrackedTime + (frameCount * frameDur)));
      ifrEl.contentWindow.postMessage(JSON.stringify({ method: "setCurrentTime", value: iframeTrackedTime }), "*");
      updateFrameReadout(iframeTrackedTime);
    }
  }

  function toggleModalPlayPause() {
    if (!activeModalVideo) return;
    const vidEl = modalPlayer.querySelector("video");
    if (vidEl) { vidEl.paused ? vidEl.play().catch(() => {}) : vidEl.pause(); return; }
    const ifrEl = modalPlayer.querySelector("iframe");
    if (ifrEl?.contentWindow) {
      iframeIsPaused = !iframeIsPaused;
      ifrEl.contentWindow.postMessage(JSON.stringify({ method: iframeIsPaused ? "pause" : "play" }), "*");
    }
  }

