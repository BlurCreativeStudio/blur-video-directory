  function seekActiveModalTo(targetSec) {
    if (!activeModalVideo) return;
    targetSec = Math.max(0, Number(targetSec) || 0);
    const vidEl = modalPlayer.querySelector("video");
    if (vidEl) { vidEl.currentTime = targetSec; vidEl.play().catch(() => {}); updateFrameReadout(targetSec); return; }
    const ifrEl = modalPlayer.querySelector("iframe");
    if (ifrEl?.contentWindow) {
