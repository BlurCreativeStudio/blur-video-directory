  async function runFullSyncWithProgress(onProgress) {
    if (isFullSyncRunning) return false;
    isFullSyncRunning = true;
    syncNowBtn.disabled = true;
    syncNowBtn.classList.add("syncing");
    syncBtnLabel.textContent = "Syncing...";

    try {
      ensureAllVideosIndexed();
      const existingById = new Map(videos.map(v => [String(v.id), v]));
      let nextUrl = `/me/videos?per_page=100&fields=${SYNC_FIELDS}`;
      const rawMap = new Map();
      let page = 0;

      while (nextUrl) {
        page++;
        const msg = `Fetching catalog page ${page} (${rawMap.size.toLocaleString()} videos found)...`;
        syncBtnLabel.textContent = `P${page}...`;
        if (onProgress) onProgress(msg, Math.min(45, page * 8));

        const data = await vimeoFetch(nextUrl);
        for (const item of (data.data || [])) {
          const id = (item.uri || "").split("/").pop();
          if (id && !rawMap.has(id)) rawMap.set(id, item);
        }
        nextUrl = data.paging?.next || null;
      }

      const rawList = Array.from(rawMap.values());
      const queue = [];
      for (const item of rawList) {
        const id = (item.uri || "").split("/").pop();
        const mod = item.modified_time || item.created_time || "";
        const prev = existingById.get(id);
        const ttConn = item.metadata?.connections?.texttracks || {};
        if ((!prev || (prev.modified || prev.created) !== mod) && ttConn.total > 0 && ttConn.uri) {
          queue.push({ id, ttUri: ttConn.uri });
        }
      }

      const newTranscripts = new Map();
      if (queue.length) {
        const totalJobs = queue.length;
        let done = 0;
        await Promise.all(Array.from({ length: Math.min(8, totalJobs) }, async () => {
          while (queue.length) {
            const job = queue.shift();
            newTranscripts.set(job.id, await downloadTimedTranscriptForItem(job.ttUri));
            done++;
            syncBtnLabel.textContent = `CC ${done}/${totalJobs}`;
            if (onProgress) {
              const pct = 45 + Math.round((done / totalJobs) * 50);
              onProgress(`Syncing time-coded transcripts (${done.toLocaleString()} of ${totalJobs.toLocaleString()})...`, pct);
            }
          }
        }));
      }

      if (onProgress) onProgress("Indexing & saving local catalog...", 96);
      const updatedVideos = rawList.map(v => {
        const id = (v.uri || "").split("/").pop();
        return buildVideoEntryFromApi(v, existingById.get(id), newTranscripts.get(id));
      });

      await commitUpdatedCatalog(updatedVideos);
      try { sessionStorage.setItem("vvd_last_delta_ts", String(Date.now())); } catch {}
      deltaBadge.style.display = "none";
      syncBtnLabel.textContent = `✓ (${videos.length})`;
      setTimeout(() => { syncBtnLabel.textContent = IS_MOBILE_SCREEN ? "Sync" : "Sync Library"; }, 3000);
      return true;
    } catch (err) {
      syncBtnLabel.textContent = "Failed";
      setTimeout(() => { syncBtnLabel.textContent = IS_MOBILE_SCREEN ? "Sync" : "Sync Library"; }, 3000);
      throw err;
    } finally {
      isFullSyncRunning = false;
      syncNowBtn.disabled = false;
      syncNowBtn.classList.remove("syncing");
    }
  }

